{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "ecc@ecc": true
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "900000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-safe-flow.sh"
          }
        ]
      }
    ]
  }
}
