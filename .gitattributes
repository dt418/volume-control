# Keep text files LF by default. Windows batch files are the only explicit
# CRLF exception because cmd.exe expects the native line ending.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts so the shebang works.
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
.githooks/pre-commit text eol=lf

# Record files are touched by every task on every branch, so a textual merge
# conflicts on purely additive edits. These drivers merge them semantically:
# feature_list.json by feature id, the markdown logs by heading block.
# scripts/install-merge-drivers.sh (or either hook installer) registers them
# in a clone; without registration git keeps the plain conflict behaviour.
claude-progress.md merge=records-md
session-handoff.md merge=records-md
feature_list.json merge=records-json

# Source/config formats: explicit LF so hooks and CI never see CRLF diffs.
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.nsi text eol=lf
*.desktop text eol=lf
*.plist text eol=lf
*.wgsl text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Binary assets: never convert or attempt to merge.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.pdb binary
*.so binary
*.dylib binary
