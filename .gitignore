# ── npx-installable third-party skills ────────────────────────────────────────
# Skills from skills-lock.json (github sources) are reproducible with
# `npx skills install <repo>` / `npx skills add <repo@skill>` — not versioned.
# Reinstall after a fresh clone: `npx skills install git@github.com:antfu/skills.git`
# Project-authored skills are whitelisted below (keep them versioned).
.agents/skills/*
.claude/skills/*
